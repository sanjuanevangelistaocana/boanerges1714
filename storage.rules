rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /noticias/{noticiaId}/adjuntos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /eventos/{eventoId}/adjuntos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
