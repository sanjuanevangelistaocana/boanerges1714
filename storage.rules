rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        (request.auth.token.admin == true ||
         request.auth.token.superadmin == true ||
         firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)));
    }

    function isCofradeOwner(cofradeId) {
      return isAuth() &&
        (firestore.get(/databases/(default)/documents/cofrades/$(cofradeId)).data.auth_uid == request.auth.uid ||
         firestore.get(/databases/(default)/documents/cofrades/$(cofradeId)).data.email == request.auth.token.email ||
         firestore.get(/databases/(default)/documents/cofrades/$(cofradeId)).data.digitalTutorEmail == request.auth.token.email ||
         firestore.get(/databases/(default)/documents/cofrades/$(cofradeId)).data.tutelado_digital == request.auth.token.email);
    }

    function isAllowedGdprFile() {
      return request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png'
        ];
    }

    // Legacy noticias paths (backward compatibility)
    match /noticias/{noticiaId}/adjuntos/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /noticias/{noticiaId}/portada/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    // New news paths (CMS module)
    match /news/{newsId}/cover/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
    match /news/{newsId}/content/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
    match /news/{newsId}/gallery/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
    match /news/{newsId}/attachments/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 20 * 1024 * 1024;
    }

    match /content/{sectionId}/images/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
    match /content/{sectionId}/documents/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }
    match /content/{sectionId}/articles/{articleId}/images/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
    match /content/{sectionId}/articles/{articleId}/documents/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }
    match /patrimonio/{fichaId}/images/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
    match /patrimonio/{fichaId}/documents/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }
    match /junta/{miembroId}/images/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
    match /grupos/{grupoId}/images/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
    match /eventos/{eventoId}/adjuntos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /surveys/{surveyId}/attachments/{fileName} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }
    match /surveys/{surveyId}/cover/{fileName} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
    match /surveys/{surveyId}/options/{optionId}/{fileName} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
    match /events/{eventId}/cover/{fileName} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }
    match /events/{eventId}/attachments/{fileName} {
      allow read: if isAdmin() ||
        (isAuth() &&
         resource != null &&
         resource.metadata.visibleToUsers == 'true');
      allow create, update, delete: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 20 * 1024 * 1024;
    }
    match /documentos/{fileName} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }
    match /cofrades/{cofradeId}/documents/gdpr/{fileName} {
      allow read: if isAdmin() || isCofradeOwner(cofradeId);
      allow create, update: if isAllowedGdprFile() &&
        (isAdmin() ||
         (isCofradeOwner(cofradeId) &&
          fileName.matches('gdpr_digital_.*\\.pdf') &&
          request.resource.contentType == 'application/pdf'));
      allow delete: if isAdmin();
    }
    match /cofrades/{cofradeId}/documents/private/{fileName} {
      allow read: if isAdmin() || isCofradeOwner(cofradeId);
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];
      allow delete: if isAdmin();
    }

    match /gallery/public/{folderId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
      allow delete: if isAdmin();
    }
    match /gallery/public/{folderId}/thumbs/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
      allow delete: if isAdmin();
    }
    match /gallery/private/{folderId}/{fileName} {
      allow read: if isAuth();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
      allow delete: if isAdmin();
    }
    match /gallery/private/{folderId}/thumbs/{fileName} {
      allow read: if isAuth();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
      allow delete: if isAdmin();
    }
    match /gallery/admin/{folderId}/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
      allow delete: if isAdmin();
    }
    match /gallery/admin/{folderId}/thumbs/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource != null &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
      allow delete: if isAdmin();
    }
    match /gallery_uploads/{uid}/{fileName} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid == uid);
      allow create, update: if isAuth() &&
        request.auth.uid == uid &&
        request.resource != null &&
        request.resource.size <= 50 * 1024 * 1024 &&
        request.resource.contentType in [
          'application/zip',
          'application/x-zip-compressed'
        ] &&
        fileName.matches('.*\\.zip');
      allow delete: if isAdmin() || (isAuth() && request.auth.uid == uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
