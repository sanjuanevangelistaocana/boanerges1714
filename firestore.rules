rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if user is admin via custom claims or admins collection.
    // The admins/{auth_uid} docs are maintained by Cloud Functions because
    // cofrade document IDs are internal COF-000xxx IDs, not Firebase Auth UIDs.
    function isAdmin() {
      return isAuth() &&
        (request.auth.token.admin == true ||
         request.auth.token.superadmin == true ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Treasury role documents are intentionally separated from cofrade records
    // so Firestore rules can authorize by auth uid without broad cofrade scans.
    function treasuryRole() {
      return isAuth() &&
        exists(/databases/$(database)/documents/treasury_roles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/treasury_roles/$(request.auth.uid)).data.role
        : '';
    }

    function canViewTreasury() {
      return isAdmin() || treasuryRole() in ['tesorero', 'junta'];
    }

    function canManageTreasury() {
      return isAdmin() || treasuryRole() == 'tesorero';
    }

    function canEditTreasurySettings() {
      return canManageTreasury();
    }

    function canApproveInvoices() {
      return canManageTreasury();
    }

    function canGenerateRemittance() {
      return canManageTreasury();
    }

    // Helper: check if user owns this cofrade document
    // Matches by auth_uid field (set during registration)
    function isOwner(cofradeId) {
      return isAuth() &&
        resource.data.auth_uid == request.auth.uid;
    }

    // Helper: check if user is tutor of this cofrade
    function isTutor() {
      return isAuth() &&
        resource.data.tutelado_digital == request.auth.token.email;
    }

    function isLinkedCofrade(cofradeId) {
      return isAuth() &&
        (cofradeId == request.auth.uid ||
         get(/databases/$(database)/documents/cofrades/$(cofradeId)).data.auth_uid == request.auth.uid ||
         get(/databases/$(database)/documents/cofrades/$(cofradeId)).data.email == request.auth.token.email ||
         get(/databases/$(database)/documents/cofrades/$(cofradeId)).data.digitalTutorEmail == request.auth.token.email ||
         get(/databases/$(database)/documents/cofrades/$(cofradeId)).data.tutelado_digital == request.auth.token.email);
    }

    function adminPermissionsConsistent() {
      return !('admin_permissions' in request.resource.data) ||
        (
          (!('cofrades' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.cofrades.write != true ||
           request.resource.data.admin_permissions.cofrades.read == true) &&
          (!('solicitudes' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.solicitudes.write != true ||
           request.resource.data.admin_permissions.solicitudes.read == true) &&
          (!('tesoreria' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.tesoreria.write != true ||
           request.resource.data.admin_permissions.tesoreria.read == true) &&
          (!('loteria' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.loteria.write != true ||
           request.resource.data.admin_permissions.loteria.read == true) &&
          (!('tunicas' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.tunicas.write != true ||
           request.resource.data.admin_permissions.tunicas.read == true) &&
          (!('festividad' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.festividad.write != true ||
           request.resource.data.admin_permissions.festividad.read == true) &&
          (!('tags' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.tags.write != true ||
           request.resource.data.admin_permissions.tags.read == true) &&
          (!('campos_configurables' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.campos_configurables.write != true ||
           request.resource.data.admin_permissions.campos_configurables.read == true) &&
          (!('seguridad_roles' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.seguridad_roles.write != true ||
           request.resource.data.admin_permissions.seguridad_roles.read == true) &&
          (!('novedades' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.novedades.write != true ||
           request.resource.data.admin_permissions.novedades.read == true) &&
          (!('proveedores' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.proveedores.write != true ||
           request.resource.data.admin_permissions.proveedores.read == true) &&
          (!('tablon' in request.resource.data.admin_permissions) ||
           request.resource.data.admin_permissions.tablon.write != true ||
           request.resource.data.admin_permissions.tablon.read == true)
        );
    }

    // Cofrades collection
    match /cofrades/{cofradeId} {
      // Authenticated users can read cofrades linked to them by auth_uid,
      // email, or tutelado_digital. Admins can read all.
      allow read: if isAuth() &&
        (resource.data.auth_uid == request.auth.uid ||
         resource.data.email == request.auth.token.email ||
         resource.data.tutelado_digital == request.auth.token.email ||
         isAdmin());

      // Allow newly registered user to link their auth_uid to their cofrade doc
      // Only if the cofrade's email matches the authenticated user's email
      // and the only fields being changed are auth_uid and fecha_actualizacion
      allow update: if isAuth() &&
        (resource.data.email == request.auth.token.email ||
         resource.data.tutelado_digital == request.auth.token.email) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['auth_uid', 'login_method', 'lastLoginMethod',
                    'authUid', 'linkedAuthProviders', 'hasLoggedIn',
                    'firstLoginAt', 'lastLoginAt', 'loginCount',
                    'fecha_actualizacion', 'ultimo_acceso']);

      allow update: if isAuth() &&
        (resource.data.auth_uid == request.auth.uid ||
         resource.data.email == request.auth.token.email) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['gdpr_firmado_digital',
                    'gdprDigitalAccepted',
                    'gdprDigitalAcceptedAt',
                    'gdprDigitalConsentVersion',
                    'gdprDigitalConsentHash',
          'gdprDigitalDocumentId',
          'gdprDigitalRevoked',
          'gdprDigitalRevokedAt',
          'gdprDigitalStatus',
          'gdprDigitalReacceptanceRequired',
                    'fecha_actualizacion']);

        // Cofrades can update their own non-sensitive fields
        // (iban, titular_iban, email, dni are now editable from profile)
        allow update: if (isOwner(cofradeId) || isTutor()) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['rol', 'role', 'roles', 'estado', 'status', 'isActive',
                     'numero', 'anio_alta', 'anios_hermandad',
                     'anio_mayordomia', 'fecha_baja', 'bajaAt', 'bajaReason',
                     'bajaBy', 'causa_baja',
                     'tiene_cuota', 'cuota_metalico', 'cuota_domiciliada',
                     'gdpr_firmado', 'auth_uid',
                     'cargo', 'gdpr_firmado_digital',
                     'fecha_gdpr_digital', 'fecha_registro_app']);

        // Fallback: allow cofrade to update if their email matches
        // (covers cases where auth_uid is not yet set on the document)
        allow update: if isAuth() &&
          resource.data.email == request.auth.token.email &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['rol', 'role', 'roles', 'estado', 'status', 'isActive',
                     'numero', 'anio_alta', 'anios_hermandad',
                     'anio_mayordomia', 'fecha_baja', 'bajaAt', 'bajaReason',
                     'bajaBy', 'causa_baja',
                     'tiene_cuota', 'cuota_metalico', 'cuota_domiciliada',
                     'gdpr_firmado', 'auth_uid',
                     'cargo', 'gdpr_firmado_digital',
                     'fecha_gdpr_digital', 'fecha_registro_app']);

      // Admins can create, update, delete any cofrade
      allow create, update, delete: if isAdmin() && adminPermissionsConsistent();

      match /documents/{documentId} {
        allow read: if isAuth() &&
          (isLinkedCofrade(cofradeId) || isAdmin());
        allow create, update: if isAdmin() ||
          (isAuth() &&
           (request.resource.data.type == 'GDPR_DIGITAL' ||
            (request.resource.data.type == 'GDPR' &&
             request.resource.data.subtype == 'GDPR_DIGITAL')) &&
           request.resource.data.cofradeId == cofradeId &&
           request.resource.data.status == 'valid' &&
           isLinkedCofrade(cofradeId));
        allow delete: if isAdmin();
      }

      match /consents/{consentVersionId} {
        allow read: if isLinkedCofrade(cofradeId) || isAdmin();
        allow create: if isLinkedCofrade(cofradeId) &&
          request.resource.data.cofradeId == cofradeId &&
          request.resource.data.consentVersionId == consentVersionId &&
          request.resource.data.accepted == true &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.source == 'private_app';
        allow update: if isAdmin() || (isLinkedCofrade(cofradeId) &&
          request.resource.data.cofradeId == cofradeId &&
          request.resource.data.status == 'revocation_requested' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['cofradeId', 'consentVersionId', 'status',
                      'consentStatus', 'revocationRequestedAt',
                      'revocationRequestedBy', 'revocationRequestedByRole',
                      'originalSignedAt', 'updatedAt', 'revocationReason']));
        allow delete: if false;
      }

      match /conversations/{conversationId} {
        allow read: if isAuth() && (isLinkedCofrade(cofradeId) || isAdmin());
        allow create: if isAdmin() &&
          request.resource.data.cofradeId == cofradeId;
        allow update: if isAuth() && (isLinkedCofrade(cofradeId) || isAdmin());
        allow delete: if isAdmin();

        match /messages/{messageId} {
          allow read: if isAuth() &&
            (isLinkedCofrade(cofradeId) || isAdmin());
          allow create: if isAuth() &&
            (isLinkedCofrade(cofradeId) || isAdmin());
          allow update, delete: if isAdmin();
        }
      }

      // Preferencias subcollection (novedades leidas, etc.)
      match /preferencias/{prefId} {
        allow read, write: if isAuth() &&
          (isLinkedCofrade(cofradeId) || isAdmin());
      }
    }

    // Cuotas collection
    match /cuotas/{cuotaId} {
      // Cofrades can read their own cuotas
      allow read: if isAuth() && isAdmin();

      // Only admins can manage cuotas
      allow create, update, delete: if isAdmin();
    }

    // Minimal cofrade search index for autocomplete.
    // Contains only non-sensitive display fields and is maintained by Cloud Functions.
    match /cofrades_busqueda/{cofradeId} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /tags_config/{tagId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /cofrade_fields_config/{fieldId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() ||
        (isAuth() &&
         request.resource.data.action in [
          'gdpr_digital_consent_accepted',
          'gdpr_digital_consent_pdf_generated',
          'gdpr_digital_consent_revocation_requested',
          'gdpr_document_uploaded',
          'gdpr_document_replaced',
          'consent_revocation_requested',
          'consent_reaccepted_by_admin',
          'email_verification_sent',
          'email_verified',
          'cofrade_field_updated',
          'google_login',
          'event_registration_created',
          'private_conversation_started',
          'private_conversation_message_sent'
         ] &&
         request.resource.data.changed_by == request.resource.data.target_id);
      allow update, delete: if false;
    }

    // Eventos collection
    match /eventos/{eventoId} {
      // Published events are readable by anyone; admins see all
      allow get: if resource.data.publicado == true || isAdmin();
      allow list: if true;

      // Only admins can manage events
      allow create, update, delete: if isAdmin();
    }

    match /event_campaigns/{campaignId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();

      match /attachments/{attachmentId} {
        allow read: if isAdmin() ||
          (isAuth() &&
           resource.data.visibleToUsers == true &&
           get(/databases/$(database)/documents/event_campaigns/$(campaignId)).data.deleted != true &&
           get(/databases/$(database)/documents/event_campaigns/$(campaignId)).data.status in ['published', 'open', 'closed', 'finished']);
        allow create, update, delete: if isAdmin();
      }

      match /popup_views/{cofradeId} {
        allow read: if isAdmin() || (isAuth() && isLinkedCofrade(cofradeId));
        allow create, update: if isAdmin() || (isAuth() && isLinkedCofrade(cofradeId));
        allow delete: if isAdmin();
      }
    }

    match /event_registrations/{registrationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // Noticias collection
    match /noticias/{noticiaId} {
      // Public news are readable by anyone. Cofrade-only news require auth.
      allow get: if isAdmin() ||
        (resource.data.publicado == true &&
         (resource.data.solo_cofrades != true || isAuth()));
      allow list: if true;

      // Only admins can manage news
      allow create, update, delete: if isAdmin();

      // Audit subcollection
      match /audit/{auditId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
      }

      // Read confirmations subcollection
      match /reads/{readId} {
        allow read: if isAdmin() || (isAuth() && readId == request.auth.uid);
        allow create, update: if isAuth();
      }

      // Analytics subcollection
      match /analytics/{analyticsId} {
        allow read: if isAdmin();
        allow create: if isAuth();
      }
    }

    // Documentos collection
    match /documentos/{documentoId} {
      // Only authenticated users can read documents
      allow read: if isAuth();

      // Only admins can manage documents
      allow create, update, delete: if isAdmin();
    }

    // Solicitudes de alta collection
    match /solicitudes/{solicitudId} {
      // Anyone can create a solicitud (public registration form)
      allow create: if true;

      // Only admins can read, update, delete solicitudes
      allow read, update, delete: if isAdmin();
    }

    // Contacto collection (public contact form)
    match /contacto/{messageId} {
      // Anyone can send a contact message
      allow create: if true;

      // Only admins can read, update, delete messages
      allow read, update, delete: if isAdmin();
    }

    // Evangelio del Día (populated by Cloud Functions)
    match /evangelio_dia/{fecha} {
      allow read: if true;
      allow write: if false;
    }

    // Sugerencias / Peticiones
    match /sugerencias/{sugerenciaId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();

      // Mensajes subcollection (conversation thread)
      match /mensajes/{mensajeId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isAdmin();
      }
    }

    // Tablón de Anuncios
    match /tablon_anuncios/{anuncioId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // Banco de Túnicas (ofertas y demandas de préstamo)
    match /banco_tunicas/{publicacionId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // Proveedores de Túnicas
    match /proveedores_tunicas/{proveedorId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // Revistas (Boanerges)
    match /revistas/{revistaId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // Páginas estáticas (La Rosa, etc.)
    match /paginas_estaticas/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin roles collection (managed by Cloud Functions only)
    match /admins/{adminUid} {
      allow read, write: if false;
    }

    match /app_config/{configId} {
      allow read, write: if isAdmin();
    }

    match /treasury_roles/{roleUid} {
      allow read: if isAuth() && (request.auth.uid == roleUid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /treasury_settings/{settingId} {
      allow read: if isAuth();
      allow create, update, delete: if canEditTreasurySettings();
    }

    match /treasury_fee_drafts/{draftId} {
      allow read: if canViewTreasury() ||
        (isAuth() &&
         resource.data.authUid is string &&
         resource.data.authUid == request.auth.uid);
      allow create, delete: if canManageTreasury();
      allow update: if canManageTreasury() ||
        (isAuth() &&
         resource.data.authUid is string &&
         resource.data.authUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['validationStatus', 'status', 'validatedIbanMasked',
                    'validatedIbanHash', 'updatedAt']));
    }

    match /treasury_invoices/{invoiceId} {
      allow read: if canViewTreasury() ||
        (isAuth() &&
         resource.data.cofradeAuthUids is list &&
         request.auth.uid in resource.data.cofradeAuthUids);
      allow create, update, delete: if canManageTreasury();
    }

    match /treasury_invoice_lines/{lineId} {
      allow read: if canViewTreasury() ||
        (isAuth() &&
         resource.data.authUid is string &&
         resource.data.authUid == request.auth.uid);
      allow create, update, delete: if canManageTreasury();
    }

    match /treasury_bank_validations/{validationId} {
      allow read: if canViewTreasury() ||
        (isAuth() &&
         resource.data.cofradeAuthUids is list &&
         request.auth.uid in resource.data.cofradeAuthUids) ||
        (isAuth() &&
         resource.data.cofradeId is string &&
         exists(/databases/$(database)/documents/cofrades/$(resource.data.cofradeId)) &&
         get(/databases/$(database)/documents/cofrades/$(resource.data.cofradeId)).data.authUid == request.auth.uid);
      allow create: if canManageTreasury();
      allow update: if canManageTreasury() ||
        (isAuth() &&
         resource.data.cofradeAuthUids is list &&
         request.auth.uid in resource.data.cofradeAuthUids &&
         request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'newIbanMasked', 'newIbanHash', 'changedAt',
                    'validatedAt', 'updatedAt', 'updatedBy'])) ||
        (isAuth() &&
         resource.data.cofradeId is string &&
         exists(/databases/$(database)/documents/cofrades/$(resource.data.cofradeId)) &&
         get(/databases/$(database)/documents/cofrades/$(resource.data.cofradeId)).data.authUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'newIbanMasked', 'newIbanHash', 'changedAt',
                    'validatedAt', 'updatedAt', 'updatedBy']));
      allow delete: if canManageTreasury();
    }

    match /treasury_remittances/{remittanceId} {
      allow read: if canViewTreasury();
      allow create, update, delete: if canGenerateRemittance();
    }

    match /treasury_payments/{paymentId} {
      allow read: if canViewTreasury() ||
        (isAuth() &&
         resource.data.authUid is string &&
         resource.data.authUid == request.auth.uid);
      allow create, update, delete: if canManageTreasury();
    }

    match /treasury_returns/{returnId} {
      allow read: if canViewTreasury() ||
        (isAuth() &&
         resource.data.authUid is string &&
         resource.data.authUid == request.auth.uid);
      allow create, update, delete: if canManageTreasury();
    }

    match /treasury_accounting_movements/{movementId} {
      allow read: if canViewTreasury();
      allow create, update, delete: if canManageTreasury();
    }

    match /treasury_categories/{categoryId} {
      allow read: if canViewTreasury();
      allow create, update, delete: if canManageTreasury();
    }

    match /treasury_cost_centers/{costCenterId} {
      allow read: if canViewTreasury();
      allow create, update, delete: if canManageTreasury();
    }

    match /treasury_audit_logs/{logId} {
      allow read: if canViewTreasury();
      allow create: if canManageTreasury() ||
        (isAuth() &&
         request.resource.data.action in ['bank_validation_confirmed',
                                          'bank_iban_modified'] &&
         request.resource.data.changedBy == request.auth.uid);
      allow update, delete: if false;
    }

    // Festividad San Juan Evangelista
    match /festividad_sje/{edicionId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();

      // Menus subcollection
      match /menus/{menuId} {
        allow read: if isAuth();
        allow create, update, delete: if isAdmin();
      }

      // Inscripciones subcollection
      match /inscripciones/{inscripcionId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isAdmin();
      }

    }

    match /legal_consents/{versionId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() ||
        (isAuth() &&
         resource.data.cofradeId is string &&
         isLinkedCofrade(resource.data.cofradeId));
      allow create: if isAdmin() ||
        (isAuth() &&
         request.resource.data.cofradeId is string &&
         request.resource.data.origin == 'cofrade' &&
         isLinkedCofrade(request.resource.data.cofradeId));
      allow update: if isAdmin() ||
        (isAuth() &&
         resource.data.cofradeId is string &&
         isLinkedCofrade(resource.data.cofradeId));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          (isAuth() &&
           get(/databases/$(database)/documents/conversations/$(conversationId)).data.cofradeId is string &&
           isLinkedCofrade(get(/databases/$(database)/documents/conversations/$(conversationId)).data.cofradeId));
        allow create: if isAdmin() ||
          (isAuth() &&
           get(/databases/$(database)/documents/conversations/$(conversationId)).data.cofradeId is string &&
           isLinkedCofrade(get(/databases/$(database)/documents/conversations/$(conversationId)).data.cofradeId));
        allow update, delete: if isAdmin();
      }
    }

    // Novedades (centralized notification system)
    match /novedades/{novedadId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // Lotería de Navidad - Campañas
    match /campanas_loteria/{campanaId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // Lotería de Navidad - Sábanas
    match /sabanas/{sabanaId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // Lotería de Navidad - Décimos/fracciones identificables
    match /decimos_loteria/{decimoId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isAuth() &&
         resource.data.vendedor_id is string &&
         get(/databases/$(database)/documents/vendedores_loteria/$(resource.data.vendedor_id)).data.cofrade_id is string &&
         get(/databases/$(database)/documents/cofrades/$(get(/databases/$(database)/documents/vendedores_loteria/$(resource.data.vendedor_id)).data.cofrade_id)).data.auth_uid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['estado', 'fecha_venta', 'returnedBySeller', 'returnedAt',
                     'returnConfirmedByAdmin', 'returnConfirmedAt']) &&
         request.resource.data.estado in ['asignado', 'vendido',
                                          'devuelto_pendiente_revision']);
    }

    // Lotería de Navidad - Vendedores
    match /vendedores_loteria/{vendedorId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // Lotería de Navidad - Asignaciones
    match /asignaciones_loteria/{asignacionId} {
      // All authenticated users can read (for availability view)
      allow read: if isAuth();
      // Admins can do anything
      allow create, delete: if isAdmin();
      // Authenticated users can update (vendedores update their own sales)
      allow update: if isAuth();
    }

    // Convocatorias collection
    match /convocatorias/{convocatoriaId} {
      // Módulo visible como Encuestas. Se mantiene colección por compatibilidad.
      allow read: if isAuth();

      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isAuth() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['total_respuestas', 'result_counts']));

      // Respuestas subcollection
      match /respuestas/{respuestaId} {
        allow read: if isAdmin() ||
          (isAuth() && (respuestaId == request.auth.uid || isLinkedCofrade(respuestaId)));

        allow create, update: if isAuth() &&
          (respuestaId == request.auth.uid ||
           request.resource.data.cofradeId == request.auth.uid ||
           request.resource.data.cofrade_id == request.auth.uid ||
           isLinkedCofrade(request.resource.data.cofradeId) ||
           isLinkedCofrade(request.resource.data.cofrade_id));

        // Only admins can delete responses
        allow delete: if isAdmin();
      }

      // Voters subcollection (for anonymous surveys)
      match /voters/{voterId} {
        allow read: if isAdmin() ||
          (isAuth() && (voterId == request.auth.uid || isLinkedCofrade(voterId)));
        allow create, update: if isAuth() &&
          (voterId == request.auth.uid || isLinkedCofrade(voterId));
        allow delete: if isAdmin();
      }
    }
  }
}
