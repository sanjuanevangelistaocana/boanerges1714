function remesa() {
  var libro = SpreadsheetApp.openById('1dhmhsNHPZUcZ7CBbKOjE5Ysxf-a5yVAuueLJYedPfp4');
  var hojaOrigen = libro.getSheetByName("Domiciliaciones");
  var hojaDestino = libro.getSheetByName("Remesa Tesorería");

  // Verificar si la hoja de destino existe, si no, crearla
  if (!hojaDestino) {
    hojaDestino = libro.insertSheet("Remesa Tesorería");
  } else {
    // Borrar contenido existente en la hoja de destino
    hojaDestino.clear();
  }

  var datosOrigen = hojaOrigen.getDataRange().getValues();

  var datosDestino = [];
  datosDestino.push(["Titular", "IBAN", "Concepto", "Importe"]);

  var ibanes = {}; // Objeto para almacenar datos según IBAN

  // Recorrer datos de la hoja origen
  for (var i = 1; i < datosOrigen.length; i++) {
    var cofradeReferencia = datosOrigen[i][1]; // Columna "Cofrade Referencia"
    var iban = datosOrigen[i][7]; // Columna "IBAN"
    var numCofrade = datosOrigen[i][0]; // Columna "Número"

    if (!ibanes[iban]) {
      ibanes[iban] = {
        titular: datosOrigen[i][6], // Columna "Titular IBAN"
        cofrades: {},
      };
    }

    ibanes[iban].cofrades[cofradeReferencia] = numCofrade;
  }

  // Procesar los datos por IBAN en la tabla de destino
  for (var iban in ibanes) {
    var numCofrades = Object.keys(ibanes[iban].cofrades).length;
    var importe = numCofrades * 22;

    // Añadir "Cuotas" y el año corriente al concepto
    var concepto = "Cuotas " + new Date().getFullYear(); // Obtener el año actual

    // Construir el concepto con Nº de cada cofrade
    var todosCofrades = Object.keys(ibanes[iban].cofrades).map(function(cofradeRef) {
      var numCofrade = ibanes[iban].cofrades[cofradeRef];
      return cofradeRef + " (" + numCofrade + ")";
    }).join(", ");

    // Unir el concepto con todos los cofrades
    var conceptoCompleto = concepto + " - " + todosCofrades;

    datosDestino.push([
      ibanes[iban].titular,
      iban,
      conceptoCompleto,
      importe,
    ]);
  }

  // Escribir datos en la hoja de destino
  hojaDestino.getRange(1, 1, datosDestino.length, datosDestino[0].length).setValues(datosDestino);
}
